# ============================================================
# jarvis-hub configuration template
# Copy to .env and fill in. Secrets can be auto-generated by scripts/seed-env.sh.
# Required: POSTGRES_PASSWORD, AUTH_TOKEN, WEBUI_SECRET_KEY,
#           RADICALE_PASSWORD, and at least one model API key.
# ============================================================

# ---- basics ----
TZ=Asia/Shanghai

# ---- database ----
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=
POSTGRES_DB=jarvis

# ---- security ----
# Internal auth token for core; Open WebUI uses it to reach core.
AUTH_TOKEN=
# Session signing key for Open WebUI.
WEBUI_SECRET_KEY=
# Keep true for the first deploy to create the admin account, then set false.
WEBUI_ENABLE_SIGNUP=true

# ---- LLM providers (primary + automatic fallback) ----
# PRIMARY_MODEL first, then BACKUP_MODELS in order.
PRIMARY_MODEL=deepseek
BACKUP_MODELS=qwen,glm
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# ---- embedding / STT (one SiliconFlow key covers both) ----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
STT_PROVIDER=siliconflow
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# ---- TTS ----
# edge = free (Microsoft Edge voices); minimax = more natural (paid)
TTS_PROVIDER=edge
EDGE_VOICE=zh-CN-YunxiNeural
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=male-qn-qingse

# ---- push (WeChat) ----
# See docs/DEPLOY.md step 9.
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=

# ---- tools ----
# QWeather (free tier: dev.qweather.com)
QWEATHER_API_KEY=
# Since 2026 QWeather requires a dedicated API Host: console.qweather.com -> settings
QWEATHER_API_HOST=
HOME_CITY=Hangzhou
SEARXNG_URL=http://searxng:8080
RADICALE_URL=http://radicale:5232/
RADICALE_USER=jarvis
RADICALE_PASSWORD=
RADICALE_CALENDAR=jarvis
BROWSER_URL=http://browser:8080
# Email (optional; QQ Mail uses an app password, ports 993/465)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- behavior ----
MAX_AGENT_STEPS=8
BRIEFING_TIME=08:00
DAILY_BRIEFING=true
MONTHLY_BUDGET_CNY=80
MEMORY_TOP_K=8
MEMORY_SIMILARITY_THRESHOLD=0.85

# ---- dynamic tools (see docs/TOOLS.md) ----
TOOLS_D_DIR=tools.d
MCP_CONFIG=mcp.json
MCP_ENABLED=true
# confirm = require approval before install (default) | auto = install directly
TOOL_INSTALL_MODE=confirm
# In auto mode, have a second model review the generated code.
REVIEW_GENERATED_TOOLS=true
TOOL_CODE_TIMEOUT=20

# ---- smart routing (cheap model for small talk, strong model for real work) ----
MODEL_POLICY=smart
CLASSIFIER_ENABLED=true
CHEAP_PROVIDER=siliconflow
CHEAP_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- model prices (CNY per 1M tokens, used for cost accounting) ----
PRICE_DEEPSEEK_IN=2
PRICE_DEEPSEEK_OUT=8
PRICE_QWEN_IN=4
PRICE_QWEN_OUT=12
PRICE_GLM_IN=5
PRICE_GLM_OUT=20
PRICE_SILICONFLOW_IN=0
PRICE_SILICONFLOW_OUT=0
EMBED_PRICE_PER_1M=0.5

# ---- images ----
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.5.20
POSTGRES_IMAGE=pgvector/pgvector:pg16

# ---- optional HTTPS for voice (written by scripts/tailscale-https.sh) ----
# CADDY_HOST=your-host.tailnet-name.ts.net
